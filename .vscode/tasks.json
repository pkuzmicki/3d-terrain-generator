{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file (Linux)",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++17",
                "-I${workspaceFolder}/include",
                "src/main.cpp",
                "src/glad.c",
                "src/stb_image.cpp",
                "-o",
                "${workspaceFolder}/terrain.exe",
                "-lglfw",
                "-lGL",
                "-lX11",
                "-lpthread",
                "-lXrandr",
                "-lXi",
                "-ldl"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": false }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (Windows)",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "-std=c++17",
                "-I${workspaceFolder}/include",
                "src/main.cpp",
                "src/glad.c",
                "src/stb_image.cpp",
                "-o",
                "${workspaceFolder}/terrain.exe",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
