{
    "version": "0.2.0",
    "configurations": [
        
        {
          "name": "Debug (Windows)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/terrain.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "C/C++: g++.exe build active file (Windows)",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "MIMode": "gdb",
            "externalConsole": false,
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ]

        },
        {
            "name": "Debug (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/terrain",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build (Linux)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}