  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Boryss\Desktop\Gardens3D\external\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" -P C:/Users/Boryss/Desktop/Gardens3D/external/glfw/CMake/GenerateMappings.cmake mappings.h.in mappings.h"
  DESC = Updating gamepad mappings from upstream repository

